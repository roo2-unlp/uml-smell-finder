@startuml
class Escuela {
    -nombre : String
    -direccion : String
    -cuit : String
    -director : String
    -matricula : Integer
    -ciclo : Integer
    -presupuesto : Real
    -turno : String
    -telefono : String
    -email : String
    +inscribirAlumno(a : Alumno) : void
    +asignarAula(a : Aula) : void
    +contratarProfesor(p : Profesor) : void
}
class Alumno {
    -nombre : String
    -legajo : Integer
    +inscribirse(c : Curso) : void
    +rendirExamen(e : Examen) : void
}
class Profesor {
    -nombre : String
    -titulo : String
    +dictarClase(c : Curso) : void
    +corregirExamen(e : Examen) : void
}
class Curso {
    -nombre : String
    -cupo : Integer
    +abrirInscripcion() : void
    +cerrarInscripcion() : void
}
class Aula {
    -numero : Integer
    -capacidad : Integer
    +reservar() : void
    +liberar() : void
}

Escuela *-- "*" Curso
Escuela *-- "*" Aula
Escuela o-- "*" Profesor
Escuela o-- "*" Alumno
Profesor --> "*" Curso : dicta
Alumno --> "*" Curso : cursa
Curso --> "1" Aula : usa
@enduml
