@startuml
class Escuela {
    -nombre : String
    -direccion : String
    -cuit : String
    -director : String
    -matricula : Integer
    -ciclo : Integer
    +inscribirAlumno(a : Alumno) : void
    +asignarAula(a : Aula) : void
    +contratarProfesor(p : Profesor) : void
    +generarBoletin(a : Alumno) : void
    +programarExamen(e : Examen) : void
    +calcularPromedio(a : Alumno) : Real
    +liquidarSueldos() : void
    +publicarCalendario() : void
}
class Profesor {
    -nombre : String
    -titulo : String
    -legajo : Integer
    +dictarClase(c : Curso) : void
    +corregirExamen(e : Examen) : void
    +planificar() : void
    +evaluar() : void
    +asistir() : void
}
class Curso {
    -nombre : String
    -cupo : Integer
    +abrirInscripcion() : void
    +cerrarInscripcion() : void
    +asignarProfesor() : void
    +cerrarActa() : void
}
class Alumno {
    -nombre : String
    +inscribirse(c : Curso) : void
    +rendirExamen(e : Examen) : void
    +justificarFalta() : void
}
class Aula {
    -numero : Integer
    +reservar() : void
    +liberar() : void
}

Escuela *-- "*" Curso
Escuela *-- "*" Aula
Escuela o-- "*" Profesor
Escuela o-- "*" Alumno
Profesor --> "*" Curso : dicta
Alumno --> "*" Curso : cursa
Curso --> "1" Aula : usa
@enduml
